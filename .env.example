# ==============================================================================
# BRANDS & CREATORS — MASTER ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# NOTE: This file is a safe, documented template for local, staging, and production.
# NEVER commit real production secrets, passwords, or live credentials to git.
#
# Variable Classification Guide:
# - SENSITIVE: Private credential, secret key, or token. Keep strictly confidential.
# - PUBLIC: Hostname, port, or client-safe public identifier.
# - REQUIRED: Essential for proper system operation.
# - OPTIONAL: Has built-in safe fallback or fallback mock mode.
# - RUNTIME: Evaluated when the Node.js / Next.js server starts.
# - BUILD-TIME: Inlined into JavaScript bundle during 'next build' (NEXT_PUBLIC_*)
# ==============================================================================

# ==============================================================================
# 1. API SERVER & BACKEND CONFIGURATION (apps/api)
# ==============================================================================
# PORT: [OPTIONAL, RUNTIME, PUBLIC] Default: 4000
PORT=4000

# NODE_ENV: [REQUIRED, RUNTIME, PUBLIC]
# Values: development | staging | production
# Setting to 'production' activates strict fail-fast cryptographic secret validation.
NODE_ENV=staging

# APP_URL: [REQUIRED, RUNTIME, PUBLIC] Web marketplace client URL (for CORS & email links)
APP_URL=https://staging.brandsandcreators.com

# ADMIN_URL: [REQUIRED, RUNTIME, PUBLIC] Admin portal URL (for CORS & admin alerts)
ADMIN_URL=https://admin.staging.brandsandcreators.com

# API_URL: [OPTIONAL, RUNTIME, PUBLIC] Canonical API base URL
API_URL=https://api.staging.brandsandcreators.com/api/v1

# ------------------------------------------------------------------------------
# Database Configuration (MongoDB Atlas Staging Cluster)
# ------------------------------------------------------------------------------
# MONGODB_URI: [REQUIRED, RUNTIME, SENSITIVE]
# MongoDB connection string. Staging requires a replica set (Atlas M0 or M10).
# Example: mongodb+srv://staging_user:password@staging-cluster.mongodb.net/brands_creators_staging?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://staging_user:your-staging-mongo-password@staging-cluster.mongodb.net/brands_creators_staging?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# JWT Authentication Secrets (Cryptographic Security)
# ------------------------------------------------------------------------------
# JWT_ACCESS_SECRET: [REQUIRED, RUNTIME, SENSITIVE] Minimum 32 characters in production
JWT_ACCESS_SECRET=your-staging-jwt-access-secret-min-32-chars-long-example

# JWT_ACCESS_EXPIRES_IN: [OPTIONAL, RUNTIME, PUBLIC] Default: 15m
JWT_ACCESS_EXPIRES_IN=15m

# JWT_REFRESH_SECRET: [REQUIRED, RUNTIME, SENSITIVE] Minimum 32 chars, distinct from access secret
JWT_REFRESH_SECRET=your-staging-jwt-refresh-secret-min-32-chars-long-example

# JWT_REFRESH_EXPIRES_IN: [OPTIONAL, RUNTIME, PUBLIC] Default: 7d
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Initial Super Admin Seed Account (Initial Bootstrap Only)
# ------------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=staging-admin@brandsandcreators.com
SUPER_ADMIN_PASSWORD=your-staging-super-admin-secure-password-2026!
SUPER_ADMIN_NAME="Brands & Creators Staging Admin"

# ------------------------------------------------------------------------------
# Media Storage (Cloudinary - Recommended for Persistent Container Uploads)
# ------------------------------------------------------------------------------
# In containerized hosting, local /uploads is wiped on restart. Cloudinary enables persistence.
CLOUDINARY_CLOUD_NAME=your-staging-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-staging-cloudinary-api-key
CLOUDINARY_API_SECRET=your-staging-cloudinary-api-secret

# ------------------------------------------------------------------------------
# Payment Gateways (STAGING SANDBOX KEYS ONLY)
# ------------------------------------------------------------------------------
# WARNING: NEVER configure live production keys in staging!
RAZORPAY_KEY_ID=rzp_test_your_staging_key_id
RAZORPAY_KEY_SECRET=your_staging_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_staging_razorpay_webhook_secret

STRIPE_SECRET_KEY=sk_test_your_staging_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_staging_stripe_webhook_secret

# ------------------------------------------------------------------------------
# Transactional Email & Queue Worker (Sandbox SMTP Provider)
# ------------------------------------------------------------------------------
# Use Mailtrap or Mailgun Sandbox domain to prevent real emails to end users.
EMAIL_PROVIDER=smtp
EMAIL_FROM="Brands & Creators Staging <notifications@staging.brandsandcreators.com>"
EMAIL_REPLY_TO=staging-support@brandsandcreators.com
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-staging-smtp-username
SMTP_PASS=your-staging-smtp-password
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_MAX_ATTEMPTS=3

# ------------------------------------------------------------------------------
# Background Queue & Worker Security (Cron Token)
# ------------------------------------------------------------------------------
# Required for calling automated workers (e.g. POST /api/v1/subscriptions/admin/process-expirations)
CRON_SECRET=your-staging-cron-secret-min-16-chars-long

# ------------------------------------------------------------------------------
# Automated Regression Testing & Rate-Limit Bypass Security
# ------------------------------------------------------------------------------
# IMPORTANT: ALLOW_RATE_LIMIT_TEST_BYPASS must be false in staging and production.
ALLOW_RATE_LIMIT_TEST_BYPASS=false
RATE_LIMIT_TEST_BYPASS_SECRET=

# ==============================================================================
# 2. MARKETPLACE CLIENT WEB APPLICATION (apps/web)
# ==============================================================================
NEXT_PUBLIC_API_URL=https://api.staging.brandsandcreators.com/api/v1
NEXT_PUBLIC_APP_URL=https://staging.brandsandcreators.com
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_staging_key_id

# ==============================================================================
# 3. ADMIN BACKOFFICE PORTAL (apps/admin)
# ==============================================================================
NEXT_PUBLIC_ADMIN_URL=https://admin.staging.brandsandcreators.com
