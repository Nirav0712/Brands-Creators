# ==============================================================================
# BRANDS & CREATORS — API BACKEND ENVIRONMENT TEMPLATE (apps/api)
# ==============================================================================
# NOTE: This is a safe configuration template for staging and production deployments.
# NEVER commit real secrets, passwords, or production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# PORT: [OPTIONAL, RUNTIME, PUBLIC] Port number for NestJS HTTP/WebSocket server.
# Default: 4000
PORT=4000

# NODE_ENV: [REQUIRED, RUNTIME, PUBLIC] Runtime environment.
# Allowed: development | staging | production
# Enforces production secrets validation when set to production.
NODE_ENV=staging

# APP_URL: [REQUIRED, RUNTIME, PUBLIC] Public URL of the marketplace web client.
# Used for CORS allowlist and transactional email links.
# Example: https://staging.brandsandcreators.com
APP_URL=https://staging.brandsandcreators.com

# ADMIN_URL: [REQUIRED, RUNTIME, PUBLIC] Public URL of the admin backoffice portal.
# Used for CORS allowlist and admin notification links.
# Example: https://admin.staging.brandsandcreators.com
ADMIN_URL=https://admin.staging.brandsandcreators.com

# API_URL: [OPTIONAL, RUNTIME, PUBLIC] Canonical external URL of this API instance.
# Example: https://api.staging.brandsandcreators.com/api/v1
API_URL=https://api.staging.brandsandcreators.com/api/v1

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB Atlas)
# ------------------------------------------------------------------------------
# MONGODB_URI: [REQUIRED, RUNTIME, SENSITIVE]
# MongoDB connection string. For staging, use a dedicated MongoDB Atlas staging cluster
# (M0 or M10) with a replica set to support transactions.
# Format: mongodb+srv://<username>:<password>@<cluster-host>/<staging-db-name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://staging_user:your-staging-mongo-password@staging-cluster.mongodb.net/brands_creators_staging?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. JWT AUTHENTICATION SECRETS (Fail-Fast Cryptographic Security)
# ------------------------------------------------------------------------------
# In production (NODE_ENV=production), secrets validator requires:
# - JWT_ACCESS_SECRET: minimum 32 characters, high entropy.
# - JWT_REFRESH_SECRET: minimum 32 characters, distinct from access secret.
#
# JWT_ACCESS_SECRET: [REQUIRED, RUNTIME, SENSITIVE] Secret for signing access tokens.
JWT_ACCESS_SECRET=your-staging-jwt-access-secret-min-32-chars-long-example

# JWT_ACCESS_EXPIRES_IN: [OPTIONAL, RUNTIME, PUBLIC] Access token lifespan.
# Default: 15m
JWT_ACCESS_EXPIRES_IN=15m

# JWT_REFRESH_SECRET: [REQUIRED, RUNTIME, SENSITIVE] Secret for signing refresh tokens.
JWT_REFRESH_SECRET=your-staging-jwt-refresh-secret-min-32-chars-long-example

# JWT_REFRESH_EXPIRES_IN: [OPTIONAL, RUNTIME, PUBLIC] Refresh token lifespan.
# Default: 7d
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. INITIAL SUPER ADMIN SEED ACCOUNT
# ------------------------------------------------------------------------------
# Used on initial database bootstrap if no super admin account exists.
#
# SUPER_ADMIN_EMAIL: [OPTIONAL, RUNTIME, SENSITIVE]
SUPER_ADMIN_EMAIL=staging-admin@brandsandcreators.com

# SUPER_ADMIN_PASSWORD: [OPTIONAL, RUNTIME, SENSITIVE] Must be a strong unique password.
SUPER_ADMIN_PASSWORD=your-staging-super-admin-secure-password-2026!

# SUPER_ADMIN_NAME: [OPTIONAL, RUNTIME, PUBLIC]
SUPER_ADMIN_NAME="Brands & Creators Staging Admin"

# ------------------------------------------------------------------------------
# 5. MEDIA & ASSET STORAGE (Cloudinary)
# ------------------------------------------------------------------------------
# In staging containers, local disk (/uploads) is ephemeral and wiped on restart.
# Cloudinary provides persistent cloud hosting for user avatars and project briefs.
#
# CLOUDINARY_CLOUD_NAME: [OPTIONAL, RUNTIME, PUBLIC]
CLOUDINARY_CLOUD_NAME=your-staging-cloudinary-cloud-name

# CLOUDINARY_API_KEY: [OPTIONAL, RUNTIME, PUBLIC]
CLOUDINARY_API_KEY=your-staging-cloudinary-api-key

# CLOUDINARY_API_SECRET: [OPTIONAL, RUNTIME, SENSITIVE]
CLOUDINARY_API_SECRET=your-staging-cloudinary-api-secret

# ------------------------------------------------------------------------------
# 6. PAYMENT GATEWAYS (Sandbox / Test Keys Only)
# ------------------------------------------------------------------------------
# Use ONLY sandbox/test keys in staging. NEVER configure live production keys.
#
# RAZORPAY_KEY_ID: [OPTIONAL, RUNTIME, PUBLIC] Sandbox Key ID starting with rzp_test_
RAZORPAY_KEY_ID=rzp_test_your_staging_key_id

# RAZORPAY_KEY_SECRET: [OPTIONAL, RUNTIME, SENSITIVE] Sandbox Key Secret
RAZORPAY_KEY_SECRET=your_staging_razorpay_secret

# RAZORPAY_WEBHOOK_SECRET: [OPTIONAL, RUNTIME, SENSITIVE] Webhook signature secret
RAZORPAY_WEBHOOK_SECRET=your_staging_razorpay_webhook_secret

# STRIPE_SECRET_KEY: [OPTIONAL, RUNTIME, SENSITIVE] Sandbox Secret Key starting with sk_test_
STRIPE_SECRET_KEY=sk_test_your_staging_stripe_secret_key

# STRIPE_WEBHOOK_SECRET: [OPTIONAL, RUNTIME, SENSITIVE] Webhook signature secret starting with whsec_
STRIPE_WEBHOOK_SECRET=whsec_your_staging_stripe_webhook_secret

# ------------------------------------------------------------------------------
# 7. EMAIL DELIVERY & NOTIFICATION QUEUE (Sandbox SMTP)
# ------------------------------------------------------------------------------
# For staging, use a sandbox email inbox (e.g. Mailtrap or Mailgun Sandbox domain)
# to ensure zero real emails are ever sent to customers.
#
# EMAIL_PROVIDER: [OPTIONAL, RUNTIME, PUBLIC] Default: smtp
EMAIL_PROVIDER=smtp

# EMAIL_FROM: [OPTIONAL, RUNTIME, PUBLIC] Default sender name and email
EMAIL_FROM="Brands & Creators Staging <notifications@staging.brandsandcreators.com>"

# EMAIL_REPLY_TO: [OPTIONAL, RUNTIME, PUBLIC]
EMAIL_REPLY_TO=staging-support@brandsandcreators.com

# SMTP_HOST: [OPTIONAL, RUNTIME, PUBLIC]
SMTP_HOST=sandbox.smtp.mailtrap.io

# SMTP_PORT: [OPTIONAL, RUNTIME, PUBLIC] 587 or 2525
SMTP_PORT=587

# SMTP_SECURE: [OPTIONAL, RUNTIME, PUBLIC] true for port 465, false for 587/2525
SMTP_SECURE=false

# SMTP_USER: [OPTIONAL, RUNTIME, SENSITIVE]
SMTP_USER=your-staging-smtp-username

# SMTP_PASS: [OPTIONAL, RUNTIME, SENSITIVE]
SMTP_PASS=your-staging-smtp-password

# ------------------------------------------------------------------------------
# 8. CRON & BACKGROUND WORKER SECURITY
# ------------------------------------------------------------------------------
# In production/staging, endpoints like POST /api/v1/subscriptions/admin/process-expirations
# require the x-cron-secret header matching CRON_SECRET (min 16 characters).
#
# CRON_SECRET: [REQUIRED, RUNTIME, SENSITIVE]
CRON_SECRET=your-staging-cron-secret-min-16-chars-long

# ------------------------------------------------------------------------------
# 9. SECURITY BYPASS FLAGS (MUST BE DISABLED IN STAGING/PRODUCTION)
# ------------------------------------------------------------------------------
# ALLOW_RATE_LIMIT_TEST_BYPASS: [REQUIRED, RUNTIME, SENSITIVE]
# MUST BE false in staging and production to prevent rate limit bypass vulnerabilities.
ALLOW_RATE_LIMIT_TEST_BYPASS=false
RATE_LIMIT_TEST_BYPASS_SECRET=

