# ==============================================================================
# BRANDS & CREATORS — ADMIN BACKOFFICE PORTAL (.env.example)
# ==============================================================================
# NOTE: Variables with the NEXT_PUBLIC_ prefix are embedded into client-side JS.
# NEVER put private server secrets, database credentials, or private API keys here.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API CONNECTION (Build-Time & Runtime)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL: [REQUIRED, PUBLIC]
# The public base URL of the backend REST API.
# Staging example: https://api.staging.brandsandcreators.com/api/v1
# Local fallback: http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=https://api.staging.brandsandcreators.com/api/v1

# API_URL: [OPTIONAL, SERVER-SIDE RUNTIME, PUBLIC]
# Used by Next.js server rewrites and CSP connect-src / img-src directives.
# Staging example: https://api.staging.brandsandcreators.com
# Local fallback: http://localhost:4000
API_URL=https://api.staging.brandsandcreators.com

# ------------------------------------------------------------------------------
# 2. APPLICATION CANONICAL HOST
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_ADMIN_URL: [REQUIRED, PUBLIC]
# The public canonical URL of the admin backoffice portal.
# Staging example: https://admin.staging.brandsandcreators.com
# Local fallback: http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=https://admin.staging.brandsandcreators.com

